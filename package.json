  "keywords": [
    "cibus",
    "pluxee",
    "sibus",
    "meal-card",
    "israel",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Michael Tadnir (https://github.com/tadnir)",
  "homepage": "https://github.com/tadnir/cibus-mcp#readme",
  "bugs": {
    "url": "https://github.com/tadnir/cibus-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tadnir/cibus-mcp.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "bin": {
    "cibus-mcp": "src/main.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "playwright": "^1.55.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
